<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="10dp"
    android:background="@drawable/input_bg"
    android:layout_marginBottom="6dp">

    <ImageView
        android:id="@+id/ivDocBadge"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:src="@drawable/ic_horizon_doc_badge" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="10dp">

        <TextView
            android:id="@+id/tvDocFileName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Document.pdf"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvDocMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1.2 MB • Sep 11, 2026"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />

    </LinearLayout>

    <ImageView
        android:id="@+id/btnDownload"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/ic_download_save"
        android:padding="4dp"
        app:tint="@color/accent_amber" />

</LinearLayout>
