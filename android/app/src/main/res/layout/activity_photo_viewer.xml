<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootPhotoViewer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Interactive Zoomable Photo Canvas -->
    <ImageView
        android:id="@+id/ivFullPhoto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Loading Spinner -->
    <ProgressBar
        android:id="@+id/pbPhotoLoading"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:indeterminateTint="@color/accent_amber"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Top Overlay Bar -->
    <LinearLayout
        android:id="@+id/layoutTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:background="@drawable/input_bg"
        android:backgroundTint="#CC0E1626"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@android:drawable/ic_menu_revert"
            android:padding="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/text_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvPhotoTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Photo"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvPhotoSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Horizon Photo"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnSharePhoto"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/ic_share"
            android:padding="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/circle_avatar_bg"
            android:backgroundTint="#40FFFFFF"
            app:tint="@color/text_primary" />

        <ImageView
            android:id="@+id/btnSavePhoto"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/ic_download_save"
            android:padding="8dp"
            android:background="@drawable/circle_avatar_bg"
            android:backgroundTint="@color/surface_elevated"
            app:tint="@color/accent_amber" />

    </LinearLayout>

    <!-- Bottom Caption Bar -->
    <LinearLayout
        android:id="@+id/layoutBottomCaption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="14dp"
        android:background="#D9162238"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/tvPhotoCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
