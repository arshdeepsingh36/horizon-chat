<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="3dp">

    <androidx.cardview.widget.CardView
        android:id="@+id/cardBubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardCornerRadius="14dp"
        app:cardElevation="1dp"
        app:cardBackgroundColor="@color/bubble_sent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp">

            <!-- Pinned Indicator -->
            <LinearLayout
                android:id="@+id/layoutPinned"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone"
                android:layout_marginBottom="4dp">
                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_link"
                    app:tint="@color/accent_amber" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pinned"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/accent_amber"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <!-- Quoted Reply Container -->
            <LinearLayout
                android:id="@+id/layoutReplyQuote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#33000000"
                android:padding="6dp"
                android:layout_marginBottom="4dp"
                android:visibility="gone">

                <View
                    android:layout_width="3dp"
                    android:layout_height="match_parent"
                    android:background="@color/accent_amber"
                    android:layout_marginEnd="6dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tvQuoteAuthor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="User"
                        android:textColor="@color/accent_amber"
                        android:textStyle="bold"
                        android:textSize="11sp" />
                    <TextView
                        android:id="@+id/tvQuoteText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Quoted text..."
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:maxLines="2"
                        android:ellipsize="end" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvMessageBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginTop="2dp">

                <TextView
                    android:id="@+id/tvTimestamp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FED7AA"
                    android:textSize="11sp" />

                <!-- Single / Double Tick Status -->
                <ImageView
                    android:id="@+id/ivTicks"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/ic_tick_double"
                    app:tint="@color/ticks_read" />

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- Floating Reactions Badge -->
    <TextView
        android:id="@+id/tvReactionsBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/circle_avatar_bg"
        android:backgroundTint="#24334D"
        android:textColor="@color/text_primary"
        android:textSize="11sp"
        android:paddingHorizontal="6dp"
        android:paddingVertical="1dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/cardBubble"
        app:layout_constraintEnd_toEndOf="@+id/cardBubble"
        android:translationY="8dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
