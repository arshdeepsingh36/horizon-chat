<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base">

    <!-- Top Bar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/chatToolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface"
        app:contentInsetStart="0dp"
        app:contentInsetEnd="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:padding="8dp"
                android:src="@android:drawable/ic_menu_revert"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/text_primary" />

            <!-- Clickable Profile Header Area -->
            <LinearLayout
                android:id="@+id/layoutToolbarProfileHeader"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp">

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/ivRecipientAvatar"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@android:drawable/sym_def_app_icon" />

                    <View
                        android:id="@+id/viewOnlineDot"
                        android:layout_width="11dp"
                        android:layout_height="11dp"
                        android:layout_gravity="bottom|end"
                        android:background="@drawable/circle_avatar_bg"
                        android:backgroundTint="@color/ticks_sent"
                        android:visibility="gone" />

                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvRecipientName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="User"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:singleLine="true"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/tvPresence"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="offline"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp"
                        android:singleLine="true" />

                </LinearLayout>

            </LinearLayout>

            <!-- Action: Search in Conversation -->
            <ImageView
                android:id="@+id/btnSearchChat"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:padding="8dp"
                android:src="@drawable/ic_search"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/text_primary" />

            <!-- Action: View Full Contact Profile -->
            <ImageView
                android:id="@+id/btnInfoProfile"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:padding="8dp"
                android:src="@drawable/ic_info"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/text_primary" />

        </LinearLayout>

    </androidx.appcompat.widget.Toolbar>

    <!-- In-Chat Message Search Bar -->
    <LinearLayout
        android:id="@+id/layoutInChatSearch"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/surface_elevated"
        android:padding="8dp"
        android:visibility="GONE"
        app:layout_constraintTop_toBottomOf="@id/chatToolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_search"
            android:layout_marginStart="8dp"
            app:tint="@color/accent_amber" />

        <EditText
            android:id="@+id/etSearchInChat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="8dp"
            android:background="@null"
            android:hint="Search messages in conversation..."
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="13sp"
            android:singleLine="true" />

        <ImageView
            android:id="@+id/btnCloseInChatSearch"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:padding="4dp"
            android:layout_marginEnd="8dp"
            app:tint="@color/text_muted" />

    </LinearLayout>

    <!-- Message Feed with Infinite Scroll -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChatMessages"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="8dp"
        android:clipToPadding="false"
        app:stackFromEnd="true"
        app:layout_constraintTop_toBottomOf="@id/layoutInChatSearch"
        app:layout_constraintBottom_toTopOf="@id/dockContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bottom Dock Container -->
    <FrameLayout
        android:id="@+id/dockContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 1. Normal Text & Media Input Bar -->
        <LinearLayout
            android:id="@+id/layoutNormalInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnAttachment"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_attach_gallery"
                app:tint="@color/text_muted"
                android:padding="4dp"
                android:clickable="true"
                android:focusable="true" />

            <ImageView
                android:id="@+id/btnCamera"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_camera"
                app:tint="@color/text_muted"
                android:padding="4dp"
                android:layout_marginStart="2dp"
                android:clickable="true"
                android:focusable="true" />

            <EditText
                android:id="@+id/etMessage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Message"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:paddingHorizontal="10dp"
                android:maxLines="4" />

            <!-- View-Once Toggle Button (1-circle icon) -->
            <ImageView
                android:id="@+id/btnViewOnceToggle"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/ic_view_once"
                app:tint="@color/text_muted"
                android:padding="4dp"
                android:clickable="true"
                android:focusable="true" />

            <!-- Hold-to-Record Microphone Button -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btnMic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/accent_amber"
                app:fabCustomSize="42dp"
                app:tint="@color/bg_base"
                android:src="@drawable/ic_mic" />

            <!-- Send Button (Shown when text is typed) -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btnSend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:backgroundTint="@color/accent_amber"
                app:fabCustomSize="42dp"
                app:tint="@color/bg_base"
                android:src="@android:drawable/ic_menu_send" />

        </LinearLayout>

        <!-- 2. Active Recording Overlay Bar -->
        <LinearLayout
            android:id="@+id/layoutRecordingBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:background="@color/surface"
            android:padding="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivRecordingDot"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_recording_dot" />

            <TextView
                android:id="@+id/tvRecordingTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="0:00"
                android:textColor="#EF4444"
                android:textStyle="bold"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvRecordingHint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:text="Release to preview voice note"
                android:textColor="@color/text_muted"
                android:textSize="13sp" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_mic"
                app:tint="#EF4444" />

        </LinearLayout>

        <!-- 3. Voice Note Staging & Playback Preview Bar -->
        <LinearLayout
            android:id="@+id/layoutVoicePreviewBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:background="@color/surface"
            android:padding="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Trash / Cancel Button -->
            <ImageView
                android:id="@+id/btnCancelVoice"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:padding="7dp"
                android:src="@drawable/ic_trash"
                app:tint="#EF4444"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true" />

            <!-- Play / Pause Preview Button -->
            <ImageView
                android:id="@+id/btnPlayVoicePreview"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:padding="6dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_play_arrow"
                app:tint="@color/accent_amber"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true" />

            <!-- Progress Bar -->
            <ProgressBar
                android:id="@+id/pbVoicePreview"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="10dp"
                android:progress="0"
                android:max="100"
                android:progressTint="@color/accent_amber"
                android:progressBackgroundTint="@color/surface_elevated" />

            <!-- Duration Label -->
            <TextView
                android:id="@+id/tvVoicePreviewDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:layout_marginEnd="10dp" />

            <!-- Dedicated Send Audio Button -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btnSendVoice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/accent_amber"
                app:fabCustomSize="42dp"
                app:tint="@color/bg_base"
                android:src="@android:drawable/ic_menu_send" />

        </LinearLayout>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
